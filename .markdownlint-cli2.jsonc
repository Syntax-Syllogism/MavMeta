{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD029": { "style": "one" },
    "MD041": false,
    "MD025": false,
  },
  "gitignore": true,
  "ignores": [
    ".history/**",
    ".claude/**",
    ".github/**",
    "CLAUDE.md",
    "GEMINI.md",
    "node_modules/**",
    "build/**",
    "dist/**",
    "dist-server/**",
    "artifacts/**",
    "memory/**",
    "**/*.tsbuildinfo",
    ".kanban/**",
    "notes/**",
    "docs/smoke-reports/**",
    "deep-dive/**",
    "**/*.log",
    ".env",
  ],
}
